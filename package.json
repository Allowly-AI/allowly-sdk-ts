{
  "name": "@allowly/sdk",
  "version": "0.1.2",
  "description": "TypeScript SDK for the Allowly API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "npm run build && node --input-type=module -e \"const sdk = await import('@allowly/sdk'); if (typeof sdk.Allowly !== 'function') process.exit(1)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allowly/verifier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
